
(rules PCB LogicBlock
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 2682)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.4)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
  )
  (rule
    (width 400.0)
    (clear 300.0)
    (clear 200.0 (type smd_to_turn_gap))
    (clear 500.0 (type default_POWER,Default))
    (clear 75.0 (type smd_smd))
    (clear 500.0 (type smd_POWER,Default))
    (clear 500.0 (type "kicad_default"_POWER,Default))
    (clear 500.0 (type POWER,Default_POWER,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-POWER,Default" "Via[0-1]_600:300_um" POWER,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    POWER,Default "Via[0-1]_600:300_um-POWER,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "/LogicBlock1bit2/Data-A" "/LogicBlock1bit3/Data-A" "/LogicBlock1bit/Data-A" "/LogicBlock1bit1/Data-A" "/LogicBlock1bit1/Data-B" "/LogicBlock1bit3/Data-B" "/LogicBlock1bit2/Data-B" "/LogicBlock1bit/Data-B"
    /LogicBlock1bit1/NOT /LogicBlock1bit/NOT /LogicBlock1bit2/NOT /LogicBlock1bit3/NOT /LogicBlock1bit2/AND /LogicBlock1bit1/AND /LogicBlock1bit3/AND /LogicBlock1bit/AND
    /LogicBlock1bit/OR /LogicBlock1bit1/OR /LogicBlock1bit2/OR /LogicBlock1bit3/OR /LogicBlock1bit1/XOR /LogicBlock1bit3/XOR /LogicBlock1bit2/XOR /LogicBlock1bit/XOR
    "unconnected-(K1-Pad4)" "Net-(K1-Pad9)" "Net-(K1-Pad11)" "unconnected-(K1-Pad6)" "unconnected-(K1-Pad8)" "unconnected-(K2-Pad6)" "Net-(K2-Pad9)" "unconnected-(K3-Pad11)"
    "unconnected-(K3-Pad6)" "unconnected-(K4-Pad13)" "unconnected-(K4-Pad11)" "unconnected-(K4-Pad9)" "unconnected-(K5-Pad6)" "unconnected-(K5-Pad4)" "unconnected-(K5-Pad8)" "Net-(K5-Pad9)"
    "Net-(K5-Pad11)" "Net-(K6-Pad9)" "unconnected-(K6-Pad6)" "unconnected-(K7-Pad6)" "unconnected-(K7-Pad11)" "unconnected-(K8-Pad11)" "unconnected-(K8-Pad9)" "unconnected-(K8-Pad13)"
    "unconnected-(K9-Pad4)" "Net-(K12-Pad8)" "Net-(K12-Pad6)" "unconnected-(K9-Pad8)" "unconnected-(K9-Pad6)" "Net-(K10-Pad9)" "unconnected-(K10-Pad6)" "unconnected-(K11-Pad11)"
    "unconnected-(K11-Pad6)" "unconnected-(K12-Pad13)" "unconnected-(K12-Pad11)" "unconnected-(K12-Pad9)" "unconnected-(K13-Pad8)" "unconnected-(K13-Pad6)" "unconnected-(K13-Pad4)" "Net-(K13-Pad11)"
    "Net-(K13-Pad9)" "Net-(K14-Pad9)" "unconnected-(K14-Pad6)" "unconnected-(K15-Pad6)" "unconnected-(K15-Pad11)" "unconnected-(K16-Pad11)" "unconnected-(K16-Pad13)" "unconnected-(K16-Pad9)"
    "Net-(D1-A)" "Net-(D2-A)" "Net-(D3-A)" "Net-(D4-A)" "Net-(D5-A)" "Net-(D6-A)" "Net-(D7-A)" "Net-(D8-A)"
    "Net-(D25-A)" "Net-(D26-A)" "Net-(D27-A)" "Net-(D28-A)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class POWER,Default
    GND +12V
    (clearance_class POWER,Default)
    (via_rule POWER,Default)
    (rule
      (width 1200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)