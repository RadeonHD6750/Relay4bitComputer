
(rules PCB MatrixROM
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 5822)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.4)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
  )
  (rule
    (width 400.0)
    (clear 300.0)
    (clear 200.0 (type smd_to_turn_gap))
    (clear 400.0 (type default_POWER,Default))
    (clear 75.0 (type smd_smd))
    (clear 400.0 (type smd_POWER,Default))
    (clear 400.0 (type "kicad_default"_POWER,Default))
    (clear 400.0 (type POWER,Default_POWER,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-POWER,Default" "Via[0-1]_600:300_um" POWER,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    POWER,Default "Via[0-1]_600:300_um-POWER,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(D1-K)" "Net-(D1-A)" "Net-(D2-A)" "Net-(D10-K)" "Net-(D11-K)" "Net-(D3-A)" "Net-(D12-K)" "Net-(D4-A)"
    "Net-(D13-K)" "Net-(D5-A)" "Net-(D14-K)" "Net-(D6-A)" "Net-(D7-A)" "Net-(D15-K)" "Net-(D16-K)" "Net-(D8-A)"
    "Net-(D9-A)" "Net-(D10-A)" "Net-(D11-A)" "Net-(D12-A)" "Net-(D13-A)" "Net-(D14-A)" "Net-(D15-A)" "Net-(D16-A)"
    "Net-(D17-A)" "Net-(D18-A)" "Net-(D19-A)" "Net-(D20-A)" "Net-(D21-A)" "Net-(D22-A)" "Net-(D23-A)" "Net-(D24-A)"
    "Net-(D25-A)" "Net-(D26-A)" "Net-(D27-A)" "Net-(D28-A)" "Net-(D29-A)" "Net-(D30-A)" "Net-(D31-A)" "Net-(D32-A)"
    "Net-(D33-A)" "Net-(D34-A)" "Net-(D35-A)" "Net-(D36-A)" "Net-(D37-A)" "Net-(D38-A)" "Net-(D39-A)" "Net-(D40-A)"
    "Net-(D41-A)" "Net-(D42-A)" "Net-(D43-A)" "Net-(D44-A)" "Net-(D45-A)" "Net-(D46-A)" "Net-(D47-A)" "Net-(D48-A)"
    "Net-(D49-A)" "Net-(D50-A)" "Net-(D51-A)" "Net-(D52-A)" "Net-(D53-A)" "Net-(D54-A)" "Net-(D55-A)" "Net-(D56-A)"
    "Net-(D57-A)" "Net-(D58-A)" "Net-(D59-A)" "Net-(D60-A)" "Net-(D61-A)" "Net-(D62-A)" "Net-(D63-A)" "Net-(D64-A)"
    "Net-(D65-A)" "Net-(D66-A)" "Net-(D67-A)" "Net-(D68-A)" "Net-(D69-A)" "Net-(D70-A)" "Net-(D71-A)" "Net-(D72-A)"
    "Net-(D73-A)" "Net-(D74-A)" "Net-(D75-A)" "Net-(D76-A)" "Net-(D77-A)" "Net-(D78-A)" "Net-(D79-A)" "Net-(D80-A)"
    "Net-(J1-Pin_1)" "Net-(J10-Pin_1)" "Net-(J17-Pin_1)" "Net-(J25-Pin_1)" "Net-(J33-Pin_1)" "Net-(J41-Pin_1)" "Net-(J49-Pin_1)" "Net-(J57-Pin_1)"
    "Net-(J65-Pin_1)" "unconnected-(J66-Pin_1-Pad1)" "Net-(J69-Pin_3)" "unconnected-(K1-Pad11)" "unconnected-(K1-Pad6)" "unconnected-(K2-Pad6)" "unconnected-(K2-Pad11)" "unconnected-(K3-Pad11)"
