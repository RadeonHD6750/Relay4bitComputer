
(rules PCB Arithmetic-Unit
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 773)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.1)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.9)
    )
  )
  (rule
    (width 500.0)
    (clear 400.0)
    (clear 250.0 (type smd_to_turn_gap))
    (clear 500.0 (type default_POWER,Default))
    (clear 100.0 (type smd_smd))
    (clear 500.0 (type smd_POWER,Default))
    (clear 500.0 (type "kicad_default"_POWER,Default))
    (clear 500.0 (type POWER,Default_POWER,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-POWER,Default" "Via[0-1]_600:300_um" POWER,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    POWER,Default "Via[0-1]_600:300_um-POWER,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "/CarryInvertOperation/A XOR B" "/XOR/Input-A" "/XOR/Input-B" "/XOR1/Input-B" "/XOR2/Input-B" "/XOR3/Input-B" "/CarryInvertOperation/Input-A" "/CarryInvertOperation/Input-B"
    "Net-(J2-Pin_3)" "Net-(J2-Pin_4)" "Net-(J2-Pin_2)" "Net-(J2-Pin_1)" "/XOR1/A XOR B" "/XOR2/A XOR B" "/XOR/A XOR B" "/XOR3/A XOR B"
    "Net-(J5-Pin_2)" "Net-(J5-Pin_1)" "Net-(J11-Pin_1)" "Net-(J11-Pin_2)" "Net-(J11-Pin_4)" "Net-(J11-Pin_3)" "Net-(J10-Pin_1)" "Net-(J10-Pin_2)"
    "unconnected-(K1-Pad13)" "unconnected-(K1-Pad11)" "unconnected-(K1-Pad9)" "unconnected-(K2-Pad11)" "unconnected-(K2-Pad13)" "Net-(K2-Pad6)" "unconnected-(K2-Pad9)" "Net-(K2-Pad8)"
    "unconnected-(K3-Pad13)" "unconnected-(K3-Pad9)" "unconnected-(K3-Pad11)" "Net-(K4-Pad8)" "Net-(K4-Pad6)" "unconnected-(K4-Pad13)" "unconnected-(K4-Pad11)" "unconnected-(K4-Pad9)"
    "unconnected-(K5-Pad9)" "unconnected-(K5-Pad11)" "unconnected-(K5-Pad13)" "Net-(K6-Pad8)" "unconnected-(K6-Pad11)" "unconnected-(K6-Pad9)" "Net-(K6-Pad6)" "unconnected-(K6-Pad13)"
    "unconnected-(K7-Pad9)" "unconnected-(K7-Pad11)" "unconnected-(K7-Pad13)" "Net-(K8-Pad8)" "unconnected-(K8-Pad13)" "Net-(K8-Pad6)" "unconnected-(K8-Pad11)" "unconnected-(K8-Pad9)"
    "unconnected-(K9-Pad11)" "unconnected-(K9-Pad13)" "unconnected-(K9-Pad9)" "Net-(K10-Pad8)" "unconnected-(K10-Pad9)" "unconnected-(K10-Pad13)" "Net-(K10-Pad6)" "unconnected-(K10-Pad11)"
    "unconnected-(K11-Pad13)" "unconnected-(K11-Pad9)" "unconnected-(K11-Pad11)" "unconnected-(J9-Pin_4-Pad4)" "unconnected-(J17-Pin_4-Pad4)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 500.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class POWER,Default
    GND +12V
    (clearance_class POWER,Default)
    (via_rule POWER,Default)
    (rule
      (width 1200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)