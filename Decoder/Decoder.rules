
(rules PCB Decoder
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 937)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.6)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
  )
  (rule
    (width 400.0)
    (clear 300.0)
    (clear 200.0 (type smd_to_turn_gap))
    (clear 400.0 (type default_POWER,Default))
    (clear 75.0 (type smd_smd))
    (clear 400.0 (type smd_POWER,Default))
    (clear 400.0 (type "kicad_default"_POWER,Default))
    (clear 400.0 (type POWER,Default_POWER,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-POWER,Default" "Via[0-1]_600:300_um" POWER,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    POWER,Default "Via[0-1]_600:300_um-POWER,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(D1-K)" "Net-(D2-K)" "Net-(D3-K)" "unconnected-(K1-Pad9)" "unconnected-(K1-Pad11)" "unconnected-(K2-Pad6)" "unconnected-(K2-Pad4)" "unconnected-(K2-Pad8)"
    "Net-(K2-Pad9)" "Net-(K2-Pad11)" "Net-(K3-Pad11)" "Net-(K3-Pad9)" "Net-(D4-K)" "unconnected-(K1-Pad13)" "Net-(K3-Pad6)" "Net-(K3-Pad8)"
    "Net-(D6-A)" "unconnected-(D6-K-Pad1)" "unconnected-(D7-K-Pad1)" "Net-(D7-A)" "unconnected-(D8-K-Pad1)" "Net-(D8-A)" "Net-(D9-A)" "unconnected-(D9-K-Pad1)"
    "unconnected-(D10-K-Pad1)" "Net-(D10-A)" "unconnected-(D11-K-Pad1)" "Net-(D11-A)" "unconnected-(D12-K-Pad1)" "Net-(D12-A)" "unconnected-(D13-K-Pad1)" "Net-(D13-A)"
    "unconnected-(D14-K-Pad1)" "Net-(D14-A)" "unconnected-(D15-K-Pad1)" "Net-(D15-A)" "Net-(D16-A)" "unconnected-(D16-K-Pad1)" "unconnected-(D17-K-Pad1)" "Net-(D17-A)"
    "Net-(J4-Pin_3)" "Net-(J4-Pin_1)" "Net-(J4-Pin_8)" "Net-(J4-Pin_5)" "Net-(J4-Pin_4)" "Net-(J4-Pin_6)" "Net-(J4-Pin_2)" "Net-(J4-Pin_7)"
    "unconnected-(K1-Pad8)" "Net-(K1-Pad6)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class POWER,Default
    GND +12V
    (clearance_class POWER,Default)
    (via_rule POWER,Default)
    (rule
      (width 1200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)