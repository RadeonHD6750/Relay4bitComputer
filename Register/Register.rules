
(rules PCB Register
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 920)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.1)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.0)
    )
  )
  (rule
    (width 400.0)
    (clear 300.0)
    (clear 200.0 (type smd_to_turn_gap))
    (clear 400.0 (type default_POWER,Default))
    (clear 75.0 (type smd_smd))
    (clear 400.0 (type smd_POWER,Default))
    (clear 400.0 (type "kicad_default"_POWER,Default))
    (clear 400.0 (type POWER,Default_POWER,Default))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via 
    "Via[0-1]_600:300_um-POWER,Default" "Via[0-1]_600:300_um" POWER,Default
  )
  (via_rule
    default "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (via_rule
    POWER,Default "Via[0-1]_600:300_um-POWER,Default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(J5-Pin_2)" "unconnected-(K1-Pad8)" "unconnected-(K1-Pad9)" "unconnected-(K2-Pad9)" "unconnected-(K2-Pad11)" "unconnected-(K2-Pad13)" "unconnected-(K3-Pad13)" "unconnected-(K3-Pad11)"
    "unconnected-(K3-Pad9)" "unconnected-(K3-Pad6)" "Net-(D12-K)" "unconnected-(K5-Pad11)" "unconnected-(K5-Pad6)" "unconnected-(K5-Pad9)" "unconnected-(K5-Pad13)" "unconnected-(K6-Pad11)"
    "unconnected-(K7-Pad9)" "unconnected-(K7-Pad13)" "unconnected-(K7-Pad11)" "unconnected-(K7-Pad6)" "unconnected-(K9-Pad13)" "unconnected-(K9-Pad6)" "unconnected-(K9-Pad9)" "unconnected-(K9-Pad11)"
    "unconnected-(K10-Pad11)" "unconnected-(K10-Pad6)" "Net-(D1-A)" "Net-(D2-A)" "Net-(D3-A)" "Net-(D4-A)" "Net-(D5-A)" "Net-(D6-A)"
    "Net-(D7-K)" "Net-(D8-K)" "Net-(D9-K)" "Net-(D11-K)" "Net-(D13-K)" "Net-(D15-K)" "Net-(J2-Pin_4)" "Net-(J2-Pin_1)"
    "Net-(J2-Pin_2)" "Net-(J2-Pin_3)" "unconnected-(K2-Pad8)" "unconnected-(K6-Pad6)"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 400.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class POWER,Default
    GND +12V
    (clearance_class POWER,Default)
    (via_rule POWER,Default)
    (rule
      (width 1200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)